{
  "name": "meeting-engine",
  "version": "0.5.1",
  "private": true,
  "description": "Static site engine for team meetings: pre-meeting surveys, in-meeting guide, post-meeting summaries and decisions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/build.mjs --content demo --out _site",
    "check": "node build/build.mjs --content demo --check",
    "dev": "node scripts/dev-server.mjs --content demo",
    "test": "node --test \"test/*.test.mjs\"",
    "dev:mock": "node scripts/dev-server.mjs --content demo --port 4322 --mock-backend",
    "dev:private": "node scripts/dev-server.mjs --content demo-private --port 4323 --local-backend --import demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "js-yaml": "5.5.0",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11"
  }
}
